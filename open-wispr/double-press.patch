+    /// In single-press mode (recording): fire immediately on modifier press-down.
+    private func handleSinglePressEvent(_ event: NSEvent) {
+        guard event.type == .flagsChanged, event.keyCode == keyCode else { return }
+
+        let isDown: Bool
+        if requiredModifiers != 0 {
+            let currentMods = UInt64(event.modifierFlags.rawValue) & 0x00FF0000
+            isDown = currentMods & requiredModifiers == requiredModifiers
+        } else {
+            isDown = !modifierPressed
+        }
+
+        if isDown {
+            modifierPressed = true
+            onSinglePressDown?()
+        } else {
+            modifierPressed = false
+        }
+    }
+
+    /// Double-press detection for modifier-only keys.
+    /// A double press is: down, up, down again within 400ms, with no other
+    /// key (or modifier) pressed in between. Single presses and chords
+    /// (e.g. Ctrl+C) never fire.
+    private func handleDoublePressEvent(_ event: NSEvent) {
+        let now = ProcessInfo.processInfo.systemUptime
+
+        if event.type == .flagsChanged && event.keyCode == keyCode {
+            let isDown: Bool
+            if requiredModifiers != 0 {
+                let currentMods = UInt64(event.modifierFlags.rawValue) & 0x00FF0000
+                isDown = currentMods & requiredModifiers == requiredModifiers
+            } else {
+                isDown = !modifierPressed
+            }
+
+            if isDown {
+                if dpWindowStart > 0,
+                   now - dpWindowStart <= 0.4,
+                   dpSawUp,
+                   !dpCancelled {
+                    // Double press detected
+                    dpWindowStart = 0
+                    dpSawUp = false
+                    dpCancelled = false
+                    modifierPressed = true
+                    onDoublePress?()
+                } else {
+                    dpWindowStart = now
+                    dpSawUp = false
+                    dpCancelled = false
+                    modifierPressed = true
+                }
+            } else {
+                modifierPressed = false
+                if dpWindowStart > 0, now - dpWindowStart <= 0.4 {
+                    dpSawUp = true
+                }
+            }
+        } else if dpWindowStart > 0, now - dpWindowStart <= 0.4 {
+            // Another key or modifier during the window: it's a chord, cancel.
+            dpCancelled = true
+        } else if dpWindowStart > 0 {
+            // Window expired
+            dpWindowStart = 0
+            dpSawUp = false
+            dpCancelled = false
+        }
+    }
+
     private func isModifierOnlyKey(_ code: UInt16) -> Bool {
         return [54, 55, 56, 58, 59, 60, 61, 62, 63].contains(code)
     }
