+++ b/Tests/OpenWisprTests/HotkeyManagerTests.swift
@@ -0,0 +1,216 @@
+import AppKit
+import XCTest
+@testable import OpenWisprLib
+
+final class HotkeyManagerTests: XCTestCase {
+    private final class VirtualScheduler {
+        var time: TimeInterval = 1
+        private var pending: [(due: TimeInterval, action: () -> Void)] = []
+
+        func schedule(_ delay: TimeInterval, _ action: @escaping () -> Void) {
+            pending.append((time + delay, action))
+        }
+
+        func advance(by interval: TimeInterval) {
+            time += interval
+            while let index = pending.firstIndex(where: { $0.due <= time }) {
+                let item = pending.remove(at: index)
+                item.action()
+            }
+        }
+    }
+
+    private func event(keyCode: UInt16, type: NSEvent.EventType,
+                       modifiers: NSEvent.ModifierFlags = []) -> NSEvent {
+        let result = NSEvent.keyEvent(
+            with: type,
+            location: .zero,
+            modifierFlags: modifiers,
+            timestamp: 0,
+            windowNumber: 0,
+            context: nil,
+            characters: "",
+            charactersIgnoringModifiers: "",
+            isARepeat: false,
+            keyCode: keyCode
+        )
+        XCTAssertNotNil(result)
+        return result!
+    }
+
+    private func tap(_ manager: HotkeyManager, keyCode: UInt16, clock: VirtualScheduler,
+                     modifiers: NSEvent.ModifierFlags = []) {
+        manager.handleEvent(event(keyCode: keyCode, type: .flagsChanged, modifiers: modifiers))
+        clock.advance(by: 0.01)
+        manager.handleEvent(event(keyCode: keyCode, type: .flagsChanged))
+    }
+
+    private func keyTap(_ manager: HotkeyManager, keyCode: UInt16,
+                        modifiers: NSEvent.ModifierFlags = []) {
+        manager.handleEvent(event(keyCode: keyCode, type: .keyDown, modifiers: modifiers))
+        manager.handleEvent(event(keyCode: keyCode, type: .keyUp, modifiers: modifiers))
+    }
+
+    func testImmediateBlankStopWithinQuietGapFiresOnceForLeftAndRightControl() {
+        for keyCode in [UInt16(59), UInt16(62)] {
+            let clock = VirtualScheduler()
+            var manager: HotkeyManager!
+            manager = HotkeyManager(keyCode: keyCode, doublePress: true,
+                                    now: { clock.time },
+                                    schedule: { clock.schedule($0, $1) })
+            var stopCount = 0
+            var startCount = 0
+            manager.start(onKeyDown: {}, onKeyUp: {},
+                          onDoublePress: { [weak manager] in startCount += 1; manager?.mode = .singlePress },
+                          onSinglePressDown: { [weak manager] in stopCount += 1; manager?.mode = .doublePress })
+            manager.stop()
+            tap(manager, keyCode: keyCode, clock: clock, modifiers: .control)
+            clock.advance(by: 0.1)
+            tap(manager, keyCode: keyCode, clock: clock, modifiers: .control)
+            clock.advance(by: 0.09)
+            XCTAssertEqual(startCount, 1)
+            XCTAssertEqual(stopCount, 0)
+            tap(manager, keyCode: keyCode, clock: clock, modifiers: .control)
+            clock.advance(by: 0.1)
+            XCTAssertEqual(stopCount, 1, "control key code \(keyCode)")
+            clock.advance(by: 0.3)
+            XCTAssertEqual(stopCount, 1)
+        }
+    }
+
+    func testHeldSecondStartTapReleaseAfterStartDoesNotStop() {
+        let clock = VirtualScheduler()
+        let manager = HotkeyManager(keyCode: 59, doublePress: true,
+                                    now: { clock.time },
+                                    schedule: { clock.schedule($0, $1) })
+        var stopCount = 0
+        manager.start(onKeyDown: {}, onKeyUp: {}, onDoublePress: { [weak manager] in manager?.mode = .singlePress },
+                      onSinglePressDown: { stopCount += 1 })
+        manager.stop()
+
+        manager.handleEvent(event(keyCode: 59, type: .flagsChanged, modifiers: .control))
+        clock.advance(by: 0.01)
+        manager.handleEvent(event(keyCode: 59, type: .flagsChanged))
+        clock.advance(by: 0.05)
+        manager.handleEvent(event(keyCode: 59, type: .flagsChanged, modifiers: .control))
+        clock.advance(by: 0.09)
+        XCTAssertEqual(manager.mode, .singlePress)
+        manager.handleEvent(event(keyCode: 59, type: .flagsChanged))
+        clock.advance(by: 0.1)
+
+        XCTAssertEqual(stopCount, 0)
+    }
+
+    func testDelayedBlankStopFiresOnce() {
+        let clock = VirtualScheduler()
+        let manager = HotkeyManager(keyCode: 59, doublePress: true,
+                                    now: { clock.time },
+                                    schedule: { clock.schedule($0, $1) })
+        var stopCount = 0
+        manager.start(onKeyDown: {}, onKeyUp: {}, onDoublePress: {}, onSinglePressDown: { stopCount += 1 })
+        manager.stop()
+        manager.mode = .singlePress
+        clock.advance(by: 0.4)
+        tap(manager, keyCode: 59, clock: clock, modifiers: .control)
+        clock.advance(by: 0.09)
+        XCTAssertEqual(stopCount, 1)
+    }
+
+    func testCtrlCChordDoesNotStop() {
+        let clock = VirtualScheduler()
+        let manager = HotkeyManager(keyCode: 59, doublePress: true,
+                                    now: { clock.time },
+                                    schedule: { clock.schedule($0, $1) })
+        var stopCount = 0
+        manager.start(onKeyDown: {}, onKeyUp: {}, onDoublePress: {}, onSinglePressDown: { stopCount += 1 })
+        manager.stop(); manager.mode = .singlePress; clock.advance(by: 0.4)
+        manager.handleEvent(event(keyCode: 59, type: .flagsChanged, modifiers: .control))
+        keyTap(manager, keyCode: 8, modifiers: .control)
+        manager.handleEvent(event(keyCode: 59, type: .flagsChanged))
+        clock.advance(by: 0.09)
+        XCTAssertEqual(stopCount, 0)
+    }
+
+    func testDelayedChordWithinGraceCancelsStop() {
+        let clock = VirtualScheduler()
+        let manager = HotkeyManager(keyCode: 59, doublePress: true,
+                                    now: { clock.time },
+                                    schedule: { clock.schedule($0, $1) })
+        var stopCount = 0
+        manager.start(onKeyDown: {}, onKeyUp: {}, onDoublePress: {}, onSinglePressDown: { stopCount += 1 })
+        manager.stop(); manager.mode = .singlePress; clock.advance(by: 0.4)
+        manager.handleEvent(event(keyCode: 59, type: .flagsChanged, modifiers: .control))
+        manager.handleEvent(event(keyCode: 59, type: .flagsChanged))
+        clock.advance(by: 0.05)
+        keyTap(manager, keyCode: 8, modifiers: .control)
+        clock.advance(by: 0.04)
+        XCTAssertEqual(stopCount, 0)
+    }
+
+    func testOneIdleTapDoesNotStart() {
+        let clock = VirtualScheduler()
+        let manager = HotkeyManager(keyCode: 59, doublePress: true,
+                                    now: { clock.time },
+                                    schedule: { clock.schedule($0, $1) })
+        var starts = 0
+        manager.start(onKeyDown: {}, onKeyUp: {}, onDoublePress: { starts += 1 })
+        manager.stop()
+        tap(manager, keyCode: 59, clock: clock, modifiers: .control)
+        clock.advance(by: 0.2)
+        XCTAssertEqual(starts, 0)
+    }
+
+    func testReleaseGapOver190MillisecondsDoesNotStart() {
+        let clock = VirtualScheduler()
+        let manager = HotkeyManager(keyCode: 59, doublePress: true,
+                                    now: { clock.time },
+                                    schedule: { clock.schedule($0, $1) })
+        var starts = 0
+        manager.start(onKeyDown: {}, onKeyUp: {}, onDoublePress: { starts += 1 })
+        manager.stop()
+        tap(manager, keyCode: 59, clock: clock, modifiers: .control)
+        clock.advance(by: 0.2)
+        tap(manager, keyCode: 59, clock: clock, modifiers: .control)
+        clock.advance(by: 0.2)
+        XCTAssertEqual(starts, 0)
+    }
+
+    func testNormalDoubleTapStarts() {
+        let clock = VirtualScheduler()
+        let manager = HotkeyManager(keyCode: 59, doublePress: true,
+                                    now: { clock.time },
+                                    schedule: { clock.schedule($0, $1) })
+        var starts = 0
+        manager.start(onKeyDown: {}, onKeyUp: {}, onDoublePress: { starts += 1 })
+        manager.stop()
+        tap(manager, keyCode: 59, clock: clock, modifiers: .control)
+        clock.advance(by: 0.1)
+        tap(manager, keyCode: 59, clock: clock, modifiers: .control)
+        clock.advance(by: 0.09)
+        XCTAssertEqual(starts, 1)
+    }
+
+    func testImmediateRestartNeedsTwoTapsAndCanRepeat() {
+        let clock = VirtualScheduler()
+        let manager = HotkeyManager(keyCode: 59, doublePress: true,
+                                    now: { clock.time },
+                                    schedule: { clock.schedule($0, $1) })
+        var starts = 0
+        var stops = 0
+        manager.start(onKeyDown: {}, onKeyUp: {}, onDoublePress: { [weak manager] in starts += 1; manager?.mode = .singlePress },
+                      onSinglePressDown: { [weak manager] in stops += 1; manager?.mode = .doublePress })
+        manager.stop()
+
+        tap(manager, keyCode: 59, clock: clock, modifiers: .control); clock.advance(by: 0.1)
+        tap(manager, keyCode: 59, clock: clock, modifiers: .control); clock.advance(by: 0.09)
+        XCTAssertEqual(starts, 1)
+        tap(manager, keyCode: 59, clock: clock, modifiers: .control); clock.advance(by: 0.09)
+        XCTAssertEqual(stops, 1)
+        tap(manager, keyCode: 59, clock: clock, modifiers: .control); clock.advance(by: 0.1)
+        XCTAssertEqual(starts, 1)
+        tap(manager, keyCode: 59, clock: clock, modifiers: .control); clock.advance(by: 0.09)
+        XCTAssertEqual(starts, 2)
+        tap(manager, keyCode: 59, clock: clock, modifiers: .control); clock.advance(by: 0.1)
+        XCTAssertEqual(stops, 2)
+    }
+}
