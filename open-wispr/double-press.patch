+    // MARK: - Recording: stop on a BLANK press only (never on chords)
+
+    private func handleSinglePressEvent(_ event: NSEvent) {
+        guard event.type == .flagsChanged, event.keyCode == keyCode else {
+            // Any other key activity while a stop press is pending means this
+            // is a chord (ctrl+C / ctrl+shift+C / ...): cancel the stop.
+            if stopPending {
+                stopPending = false
+                pendingStopCancelled = true
+            }
+            return
+        }
+
+        let now = now()
+        let isDown = !modifierPressed
+
+        if isDown {
+            modifierPressed = true
+            lastDownAt = now
+
+            // Once recording starts, the next blank tap must stop it, even
+            // immediately. The start tap's release alone cannot arm a stop.
+            stopPending = true
+            pendingStopCancelled = false
+        } else {
+            modifierPressed = false
+            lastUpAt = now
+
+            if stopPending {
+                // Blank press. Confirm after a short grace: if a chord key is
+                // delivered right after the release (Karabiner reordering), it
+                // cancels in time.
+                schedule(stopGrace) { [weak self] in
+                    guard let self = self else { return }
+                    if self.stopPending && !self.pendingStopCancelled {
+                        self.stopPending = false
+                        self.onSinglePressDown?()
+                    }
+                }
+            }
+        }
+    }
+
+    // MARK: - Idle: start on two taps inside the window
+
+    private func handleDoublePressEvent(_ event: NSEvent) {
+        guard event.type == .flagsChanged, event.keyCode == keyCode else {
+            // A chord key or stray key while a start is pending cancels it
+            // (e.g. ctrl tap + ctrl+C right after the second tap).
+            if startPending && (event.type == .keyDown || event.type == .flagsChanged) {
+                startPending = false
+                pendingStartCancelled = true
+            }
+            return
+        }
+
+        let now = now()
+        let isDown = !modifierPressed
+
+        if isDown {
+            modifierPressed = true
+
+            if startPending {
+                // Third tap of a buzz while a start is pending: ignore it and
+                // let the pending start fire on its grace timer.
+                return
+            }
+
+            // Evaluate against the PREVIOUS tap before recording this one.
+            let gapFromUp = lastUpAt > 0 ? now - lastUpAt : .infinity
+            let sawRelease = lastUpAt > lastDownAt  // the key was fully released after the previous press
+
+            let qualifies =
+                (sawRelease && gapFromUp <= dpGap) ||   // normal double tap (window from release)
+                (lastDownAt > 0 &&                      // up was merged/dropped by the OS:
+                 now - lastDownAt <= dpNoUpFallback)    // second down came ~immediately after the first
+
+            lastDownAt = now
+
+            if qualifies {
+                startPending = true
+                pendingStartCancelled = false
+                // Chord-confirm grace: ctrl+C pressed right after the second
+                // tap cancels this before recording starts.
+                schedule(stopGrace) { [weak self] in
+                    guard let self = self else { return }
+                    if self.startPending && !self.pendingStartCancelled {
+                        self.startPending = false
+                        self.onDoublePress?()
+                    }
+                }
+            }
+        } else {
+            modifierPressed = false
+            lastUpAt = now
+        }
+    }
+
     private func isModifierOnlyKey(_ code: UInt16) -> Bool {
         return [54, 55, 56, 58, 59, 60, 61, 62, 63].contains(code)
     }
diff --git a/Tests/OpenWisprTests/HotkeyManagerTests.swift b/Tests/OpenWisprTests/HotkeyManagerTests.swift
